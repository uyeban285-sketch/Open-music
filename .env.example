# Скопируйте файл в .env и при необходимости измените значения.

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=open_music
POSTGRES_PASSWORD=open_music_dev
POSTGRES_DB=open_music
DATABASE_URL=postgresql://open_music:open_music_dev@localhost:5432/open_music

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=open_music
S3_SECRET_KEY=open_music_dev
S3_BUCKET=open-music-dev

# --- App ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001
AI_SERVICE_URL=http://localhost:8001

# --- Auth ---
# Генерация: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- KMS (Token Vault) ---
# Допустимые значения: mock | localstack | aws | vault
KMS_BACKEND=mock
# AWS KMS (используется при KMS_BACKEND=aws)
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
# HashiCorp Vault Transit (используется при KMS_BACKEND=vault)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_TRANSIT_KEY=open-music-kek
# LocalStack (используется при KMS_BACKEND=localstack)
LOCALSTACK_ENDPOINT=http://localhost:4566
