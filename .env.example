# Скопируйте файл в .env и при необходимости измените значения.

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=open_music
POSTGRES_PASSWORD=open_music_dev
POSTGRES_DB=open_music
DATABASE_URL=postgresql://open_music:open_music_dev@localhost:5432/open_music

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=open_music
S3_SECRET_KEY=open_music_dev
S3_BUCKET=open-music-dev

# --- App ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001
AI_SERVICE_URL=http://localhost:8001


# --- Mock KMS (локальная разработка, KMS_BACKEND=mock) ---
MOCK_KMS_URL=http://localhost:2599

# --- NextAuth ---
NEXTAUTH_SECRET=change_me_in_production
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
