{
  "name": "@open-music/api",
  "version": "0.0.0",
  "private": true,
  "description": "Open Music backend API (NestJS)",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed:dev": "ts-node --project tsconfig.json src/seed.ts"
  },
  "dependencies": {
    "@open-music/shared": "workspace:*",
    "@open-music/connector-yandex-music": "workspace:*",
    "@open-music/connector-youtube-music": "workspace:*",
    "@open-music/connector-file-import": "workspace:*",
    "@nestjs/core": "^10.4.4",
    "@nestjs/common": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8",
    "@prisma/client": "^5.22.0",
    "ioredis": "^5.4.1",
    "argon2": "^0.41.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/express": "^5.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.5.4",
    "prisma": "^5.22.0",
    "pino-pretty": "^13.0.0",
    "ts-node": "^10.9.2",
    "vitest": "^2.1.0",
    "unplugin-swc": "^1.5.1",
    "@swc/core": "^1.7.0"
  }
}
