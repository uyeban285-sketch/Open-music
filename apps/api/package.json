{
  "name": "@open-music/api",
  "version": "0.0.0",
  "private": true,
  "description": "Open Music backend API (NestJS)",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "@open-music/shared": "workspace:*",
    "@open-music/connector-yandex-music": "workspace:*",
    "@open-music/connector-youtube-music": "workspace:*",
    "@open-music/connector-file-import": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "5.9.3"
  }
}
